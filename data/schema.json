{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/koidosthai-oss/Indian-places/data/schema.json",
  "title": "India place record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "type",
    "state",
    "district",
    "sources",
    "collected_date",
    "verified"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "local_name": { "type": ["string", "null"] },
    "type": {
      "type": "string",
      "enum": [
        "village",
        "town",
        "city",
        "hamlet",
        "tourist_spot",
        "hidden_gem",
        "other"
      ]
    },
    "state": { "type": "string", "minLength": 1 },
    "district": { "type": "string", "minLength": 1 },
    "subdistrict_tehsil": { "type": ["string", "null"] },
    "latitude": { "type": ["number", "null"] },
    "longitude": { "type": ["number", "null"] },
    "sources": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": { "type": ["string", "null"] },
    "collected_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "verified": { "type": "boolean" }
  }
}
