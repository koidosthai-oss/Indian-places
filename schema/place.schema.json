{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/koidosthai-oss/Indian-places/place.schema.json",
  "title": "Indian tourism place",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "state", "category", "description"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": { "type": "string", "minLength": 1 },
    "state": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": [
        "heritage",
        "nature",
        "spiritual",
        "beach",
        "hill-station",
        "wildlife",
        "offbeat",
        "other"
      ]
    },
    "description": { "type": "string", "minLength": 10 },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": 6, "maximum": 37 },
        "lon": { "type": "number", "minimum": 68, "maximum": 98 }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 10, "maxLength": 240 }
    }
  }
}
